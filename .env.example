# Copy to .env (ignored by git). Never paste keys into chat or commit them.
VENICE_API_KEY=

# Render service (enclave/server.mjs). `npm run dev` fills in the secret and
# worker URL for local runs; in Phala these are encrypted environment variables.
# CONFIDENTIAL_AI_KEY=      Phala Confidential AI key (fusion and matching)
# ENCLAVE_SECRET=           same value as the worker's ENCLAVE_SECRET
# WORKER_URL=               the worker's URL, e.g. https://zkads.example
# RECLAIM_APP_ID=           Reclaim developer app (Codex usage proofs)
# RECLAIM_APP_SECRET=
# RECLAIM_PROVIDER_ID=      the custom provider for ChatGPT's Codex usage page
# RECLAIM_PROVIDER_VERSION= its exact version (pinned in enclave/docker-compose.yml)
# RECLAIM_TOKENS_PARAM=     the provider's parameter holding the token count (default: tokens)

# Deploying the worker (npm run deploy):
# CLOUDFLARE_API_TOKEN=      account token: Workers Scripts edit, R2 edit, Account Settings read
# CLOUDFLARE_ACCOUNT_ID=
# ZKADS_PUBLIC_URL=          https://zkads.<subdomain>.workers.dev
# ZKADS_ADMIN_TOKEN=         32+ random characters
# ZKADS_ENCLAVE_SECRET=      32+ random characters, the same as the render service's ENCLAVE_SECRET
# ZKADS_ENCLAVE_URL=         the render service's Phala URL, once deployed
